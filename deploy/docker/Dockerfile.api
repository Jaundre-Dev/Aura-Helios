FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props global.json ./
COPY src/Helios.Contracts/Helios.Contracts.csproj      src/Helios.Contracts/
COPY src/Helios.Domain/Helios.Domain.csproj            src/Helios.Domain/
COPY src/Helios.Application/Helios.Application.csproj  src/Helios.Application/
COPY src/Helios.Infrastructure/Helios.Infrastructure.csproj src/Helios.Infrastructure/
COPY src/Helios.Api/Helios.Api.csproj                  src/Helios.Api/
RUN dotnet restore src/Helios.Api/Helios.Api.csproj

COPY src/ src/
RUN dotnet publish src/Helios.Api/Helios.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Helios.Api.dll"]
