# Copy to deploy/compose/.env before running docker compose.
# Docker Compose reads .env from the directory holding the compose file.

MYSQL_DATABASE=helios
MYSQL_USER=helios
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# This machine already runs a native MySQL80 service listening on 3306, so the container
# cannot bind that port. Pick one:
#
#   3307  run both side by side  (then use Port=3307 in the connection string)
#   3306  after stopping the native service:  Stop-Service MySQL80
#
MYSQL_HOST_PORT=3307

REDIS_HOST_PORT=6379
