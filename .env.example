# ---------------------------------------------------------------------------
# HELIOS — environment template. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
HELIOS_ENVIRONMENT=Development
HELIOS_API_URL=http://localhost:5080
HELIOS_WEB_URL=http://localhost:5173

# --- MySQL (durable source of truth) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=helios
MYSQL_USER=helios
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Redis (queues, cache, locks, event fan-out) ---
REDIS_CONNECTION=localhost:6379

# --- Auth ---
HELIOS_JWT_ISSUER=helios
HELIOS_JWT_AUDIENCE=helios-web
HELIOS_JWT_SIGNING_KEY=replace-with-32-byte-minimum-secret

# --- Local inference ---
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1

# --- Cloud providers (optional; leave blank to disable that provider) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OLLAMA_CLOUD_API_KEY=

# --- Generic OpenAI-compatible provider ---
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_API_KEY=

# --- Policy defaults ---
HELIOS_DEFAULT_DATA_CLASSIFICATION=INTERNAL
HELIOS_RESTRICTED_LOCAL_ONLY=true
