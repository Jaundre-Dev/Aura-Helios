# ---------------------------------------------------------------------------
# HELIOS — environment template. Copy to .env and fill in. Never commit .env.
# Values here are placeholders, not credentials.
# ---------------------------------------------------------------------------

# --- Core ---
HELIOS_ENVIRONMENT=Development
HELIOS_API_URL=http://localhost:5080
HELIOS_WEB_URL=http://localhost:5173

# --- MySQL (durable source of truth) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=helios
MYSQL_USER=helios
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Redis (cache and rate limiting only; never the only copy of business state) ---
REDIS_CONNECTION=localhost:6379

# --- Auth ---
HELIOS_JWT_ISSUER=helios
HELIOS_JWT_AUDIENCE=helios-web
# 32+ random characters. Rotating it signs every user out.
HELIOS_JWT_SIGNING_KEY=

# --- Tenant secret encryption (AES-256-GCM master key) ---
# Base64 of 32 random bytes. Losing it makes stored tenant secrets unrecoverable;
# keep it in a secret manager with a documented backup and rotation procedure.
HELIOS_SECRETS_ACTIVE_KEY_ID=k1
HELIOS_SECRETS_KEY_K1=

# --- Integration tests ---
# Server credentials only. Tests create and drop their own helios_it_* database and
# refuse non-local hosts unless HELIOS_TEST_ALLOW_REMOTE_HOST=1.
# HELIOS_TEST_CONNECTION=Server=127.0.0.1;Port=3306;User=helios_test;Password=...;
