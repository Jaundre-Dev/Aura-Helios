{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Helios": {
    "Database": { "ServerVersion": "8.0.46" },
    "Worker": {
      "Concurrency": 4,
      "PollSeconds": 2
    },
    "Execution": {
      "LeaseSeconds": 120,
      "RetryBaseDelaySeconds": 5,
      "ReconcileDelaySeconds": 30,
      "MaxReconcileAttempts": 10
    }
  },
  "ConnectionStrings": {
    "MySql": "",
    "Redis": "localhost:6379"
  }
}
